NODE_ENV=development
PORT=3000
CORS_ORIGIN=http://localhost:5173
# Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=28800
EMPLOYEES_SERVICE_HOST=localhost
EMPLOYEES_SERVICE_PORT=4001
UPLOAD_DIR=uploads
# Set when running behind a reverse proxy (e.g. the nginx in docker-compose)
TRUST_PROXY=false
# Defaults to false when NODE_ENV=production
API_DOCS_ENABLED=true
ATTENDANCE_SERVICE_HOST=localhost
ATTENDANCE_SERVICE_PORT=4002
