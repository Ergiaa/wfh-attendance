{
  "name": "wfh-attendance",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build:packages": "npm run build -w @wfh/contracts -w @wfh/nest-common",
    "dev:contracts": "npm run dev -w @wfh/contracts",
    "dev:nest-common": "npm run dev -w @wfh/nest-common",
    "dev:employees": "npm run build:packages && npm run start:dev -w employees-service",
    "dev:attendance": "npm run build:packages && npm run start:dev -w attendance-service",
    "dev:gateway": "npm run build:packages && npm run start:dev -w gateway",
    "dev:web": "npm run dev -w web",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "oxlint --type-aware apps packages",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down"
  },
  "devDependencies": {
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2"
  }
}
